# AapdaMitra environment variables
# Copy this file to .env and fill in your values.
# Never commit the real .env to git.

# LLM provider: groq (default) or gemini
LLM_PROVIDER=groq

# Groq API key — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API key — https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# API access key — protects the backend from public access.
# Set any long random string here (e.g. openssl rand -hex 32).
# The same value must be set on BOTH the API and the UI service on Render.
# Leave blank to disable the guard (useful for local development).
API_SECRET_KEY=
